scripts/

# Outillage interne : le script d'émission de licences n'a rien à faire chez
# le client (il exige de toute façon la clé privée, qui vit hors dépôt).
test/

# Banc d'essai des fuites (corpus fictif, outillage interne).
bench/

# Docs internes : elles citent l'emplacement de la clé privée et le circuit de
# vente — rien à faire chez le client.
README.md
LIVRAISON.md
node_modules/.bin/
node_modules/@modelcontextprotocol/client/
.git/
*.mcpb


# Tesseract : NE PAS élaguer les variantes de tesseract.js-core.
# Tenté puis annulé : ne garder que les « -lstm » économise ~15 Mo mais casse
# l'OCR dans le bundle — le worker réclame aussi une variante « legacy » à un
# moment de son cycle (Cannot find module tesseract-core-relaxedsimd).
# Le poids est le prix de la fiabilité sur des machines inconnues.

# Dossier de confiance (documents clients, pas du code).
confiance/

# Outil de construction du paquet navigateur (dépendance de développement) et
# ce paquet lui-même : rien à faire dans l'extension Claude Desktop.
node_modules/esbuild/
node_modules/@esbuild/
# Ancré à la racine : « dist/ » tout court exclurait aussi node_modules/*/dist
# (xlsx, SDK MCP…) et l'extension ne démarrerait plus.
/dist/
