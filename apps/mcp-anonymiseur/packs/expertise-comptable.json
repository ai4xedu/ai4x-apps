        "provisions",
        "stocks",
        "créances clients",
        "dettes fournisseurs",
        "capitaux propres",
        "trésorerie",
        "charges constatées d'avance",
        "produits constatés d'avance",
        "lettrage",
        "rapprochement bancaire",
        "clôture",
        "exercice comptable",
        "liasse fiscale",
        "annexe"
      ]
    },
    {
      "id": "P-011",
      "type": "laisser_en_clair",
      "libelle": "Impôts, taxes et administrations",
      "termes": [
        "TVA collectée",
        "TVA déductible",
        "TVA à payer",
        "crédit de TVA",
        "impôt sur les sociétés",
