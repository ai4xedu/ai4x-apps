  ],
  "entetes": [
    {
      "motif": "n[°o]\\s*(?:de\\s*)?facture|facture|invoice|n[°o]\\s*(?:de\\s*)?pi[èe]ce|pi[èe]ce|r[ée]f[ée]rence\\s*(?:pi[èe]ce|[ée]criture)",
      "prefixe": "PIECE",
      "libelle": "Pièce / facture",
      "exemple": "N° facture"
    },
    {
      "motif": "tiers|client|fournisseur|compte\\s*tiers|auxiliaire",
      "prefixe": "SOCIETE",
      "libelle": "Tiers",
      "exemple": "Compte tiers"
    }
  ]
