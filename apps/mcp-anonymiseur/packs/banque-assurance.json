{
  "format": "hidden-tokens.pack/1",
  "id": "banque-assurance",
  "nom": "Banque et assurance",
  "version": "1.1.0",
  "description": "IBAN de tous pays (clé mod 97) et RIB marocain codés RIB, BIC/SWIFT, carte : cryptogramme (CVV), n° de police, de sinistre, de chèque et de LCN annoncés, plaques marocaines ; régulateurs, banques, assureurs, sigles de la conformité et vocabulaire des contrats laissés en clair.",
  "regles": [
    {"id": "P-001", "type": "motif", "libelle": "IBAN (tous pays, clé vérifiée)", "prefixe": "RIB",
      "motif": "(?<![A-Z0-9])[A-Z]{2}\\d{2}(?:[ ]?[A-Z0-9]){11,30}(?![A-Z0-9])", "exemple": "FR76 3000 6000 0112 3456 7890 189", "controle": "iban"},
    {"id": "P-002", "type": "motif", "libelle": "BIC / SWIFT annoncé", "prefixe": "BIC",
      "motif": "(?<=\\b(?:BIC|SWIFT)\\s*[:=]?\\s*)[A-Z]{6}[A-Z0-9]{2}(?:[A-Z0-9]{3})?(?![A-Z0-9])", "exemple": "BIC : ABCDMAMCXXX"},
    {"id": "P-003", "type": "motif", "libelle": "Numéro de police d'assurance annoncé", "prefixe": "POLICE",
      "motif": "(?<=\\bpolice[ \\t]*(?:d'assurance)?[ \\t]*(?:n[°o]\\.?)?[ \\t]*[:=]?[ \\t]*)(?![A-Z]{2,}-(?:\\d{3}|\\d{8})(?![A-Z0-9-]))(?=[A-Z/-]*\\d)[A-Z0-9][A-Z0-9/-]{5,19}(?![A-Z0-9/-])", "exemple": "police n° AUT/2026/004512"},
    {"id": "P-004", "type": "motif", "libelle": "Numéro de sinistre annoncé", "prefixe": "SINISTRE",
      "motif": "(?<=\\bsinistre[ \\t]*(?:n[°o]\\.?)?[ \\t]*[:=]?[ \\t]*)(?![A-Z]{2,}-(?:\\d{3}|\\d{8})(?![A-Z0-9-]))(?=[A-Z/-]*\\d)[A-Z0-9][A-Z0-9/-]{5,19}(?![A-Z0-9/-])", "exemple": "sinistre n° SIN-26-00871"},
    {"id": "P-005", "type": "motif", "libelle": "Numéro de chèque annoncé", "prefixe": "CHEQUE",
      "motif": "(?<=\\bch[èe]que\\s*(?:n[°o]\\.?)?\\s*[:=]?\\s*)\\d{7}(?!\\d)", "exemple": "chèque n° 1234567"},
    {"id": "P-006", "type": "motif", "libelle": "Numéro de LCN (lettre de change normalisée) annoncé", "prefixe": "LCN",
      "motif": "(?<=\\bLCN[ \\t]*(?:n[°o]\\.?)?[ \\t]*[:=]?[ \\t]*)\\d{7}(?!\\d)", "exemple": "LCN n° 1234567"},
    {"id": "P-007", "type": "motif", "libelle": "Cryptogramme de carte (CVV / CVC) annoncé", "prefixe": "CVV",
      "motif": "(?<=\\b(?:CVV2?|CVC2?|cryptogramme(?:[ \\t]+visuel)?)[ \\t]*[:=]?[ \\t]*)\\d{3,4}(?!\\d)", "exemple": "CVV 123"},
    {"id": "P-008", "type": "motif", "libelle": "Plaque d'immatriculation marocaine (n° - lettre - préfecture)", "prefixe": "IMMAT",
      "motif": "(?<![\\p{L}\\p{N}/|-])\\d{1,5}(?:-[ABDEHW]-|/[ABDEHW]/|[ \\t]*\\|[ \\t]*[ABDEHW][ \\t]*\\|[ \\t]*)\\d{1,2}(?![\\p{L}\\p{N}/|-])", "exemple": "12345-A-6"},
    {"id": "P-009", "type": "motif", "libelle": "RIB marocain (24 chiffres, en groupes ou collé)", "prefixe": "RIB",
      "motif": "(?<![\\d.-])(?:\\d{3}[ .-]?\\d{3}[ .-]?\\d{16}[ .-]?\\d{2}|\\d{4} \\d{4} \\d{4} \\d{4} \\d{4} \\d{4})(?!\\d|[.-]\\d)", "exemple": "011 780 0000123456789012 34"},
    {"id": "P-010", "type": "laisser_en_clair", "libelle": "Régulateurs, banques et assureurs de la place", "termes": ["Bank Al-Maghrib", "ACAPS", "AMMC", "Attijariwafa bank", "Banque Populaire", "Bank of Africa", "CIH Bank", "Crédit du Maroc", "Société Générale", "Crédit Agricole", "Al Barid Bank", "Wafa Assurance", "RMA", "AXA", "Sanlam", "AtlantaSanad", "MAMDA", "BAM", "UTRF", "Tamwilcom", "CDG", "CMI"]},
    {"id": "P-011", "type": "laisser_en_clair", "libelle": "Vocabulaire des contrats", "termes": ["tous risques", "responsabilité civile", "franchise", "prime", "bonus-malus", "sinistre", "avenant", "échéance"]},
    {"id": "P-012", "type": "laisser_en_clair", "libelle": "Sigles de la conformité et du crédit", "termes": ["KYC", "PPE", "LCN", "CVV", "CVC", "TEG", "TAEG", "LAB-FT", "AML", "SWIFT"]}
  ]
}
