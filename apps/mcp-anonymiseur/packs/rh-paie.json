{
  "format": "hidden-tokens.pack/1",
  "id": "rh-paie",
  "nom": "RH et paie",
  "version": "1.0.0",
  "description": "Matricules, numéros de badge et de contrat de travail annoncés ; CNSS, numéro de sécurité sociale, IBAN, dates de naissance sont reconnus par le moteur ; les salaires relèvent du réglage Nombres (finance d'une personne, protégée par défaut). Intitulés de postes, droit du travail, éléments de paie et organismes laissés en clair pour que l'IA travaille sur un contrat, un entretien annuel ou une procédure.",
  "regles": [
    {
      "id": "P-001",
      "type": "motif",
      "libelle": "Matricule salarié annoncé",
      "prefixe": "MATRICULE",
      "motif": "(?<=\\bmatricule\\s*(?:salari[ée]|employ[ée])?\\s*(?:n[°o]\\.?)?\\s*[:=]?\\s*)[A-Z0-9][A-Z0-9-]{2,12}(?![A-Z0-9-])",
      "exemple": "matricule : EMP-04471"
    },
    {
      "id": "P-002",
      "type": "motif",
      "libelle": "Numéro de badge annoncé",
      "prefixe": "BADGE",
      "motif": "(?<=\\bbadge\\s*(?:n[°o]\\.?)?\\s*[:=]?\\s*)[A-Z0-9][A-Z0-9-]{2,12}(?![A-Z0-9-])",
      "exemple": "badge n° 00812"
    },
    {
      "id": "P-003",
