{
  "format": "hidden-tokens.pack/1",
  "id": "notariat-ma",
  "nom": "Notariat — étude de notaire, Maroc",
  "version": "1.0.0",
  "description": "Numéros de titre foncier (avec leur indice de conservation : 12345/63, 28.517/C), de réquisition d'immatriculation, de minute, de répertoire et d'acte adoulaire annoncés, et nom de la propriété (« propriété dite … ») codés sous leur nom ; conservation foncière, hypothèque, indivision, succession, actes adoulaires, fiscalité de l'acte et institutions laissés en clair pour que l'IA travaille sur un acte de vente, une promesse ou un partage successoral. Parties, CIN, RIB, ICE et RC restent l'affaire du moteur ; les montants, du réglage Nombres.",
  "regles": [
    {
      "id": "P-001",
      "type": "motif",
      "libelle": "Numéro de titre foncier (avec indice de conservation)",
      "prefixe": "TF",
      "motif": "(?<=(?:\\btitres?\\s+fonciers?|\\bT\\.?\\s?F\\.?)(?:\\s+m[èe]re)?\\s*(?:n[°o]s?\\.?|num[ée]ro)?\\s*[:=]?\\s*)(?:\\d{1,3}[. ]\\d{3}|\\d{1,7})\\s?/\\s?(?:\\d{1,3}|[A-Z]{1,2})(?![\\p{L}\\d])",
      "exemple": "titre foncier n° 12345/63"
    },
    {
      "id": "P-002",
      "type": "motif",
      "libelle": "Numéro de réquisition d'immatriculation",
      "prefixe": "REQUISIT",
      "motif": "(?<=\\br[ée]quisitions?\\s+(?:d['’]\\s?immatriculation\\s+)?(?:n[°o]s?\\.?|num[ée]ro)?\\s*[:=]?\\s*)(?:\\d{1,3}[. ]\\d{3}|\\d{1,7})(?:\\s?/\\s?(?:\\d{1,3}|[A-Z]{1,2}))?(?![\\p{L}\\d])",
      "exemple": "réquisition d'immatriculation n° 6789/63"
    },
    {
      "id": "P-003",
      "type": "motif",
      "libelle": "Numéro de minute annoncé",
      "prefixe": "MINUTE",
      "motif": "(?<=\\bminutes?\\s*(?:n[°o]s?\\.?|num[ée]ro)\\s*[:=]?\\s*)\\d(?:[\\d/.-]{0,14}\\d)?(?![\\d/])",
      "exemple": "minute n° 2026/0412"
    },
    {
      "id": "P-004",
      "type": "motif",
      "libelle": "Numéro de répertoire annoncé",
      "prefixe": "REPERTOIRE",
      "motif": "(?<=\\br[ée]pertoire\\s*(?:g[ée]n[ée]ral\\s*)?(?:n[°o]s?\\.?|num[ée]ro)\\s*[:=]?\\s*)\\d(?:[\\d/.-]{0,14}\\d)?(?![\\d/])",
      "exemple": "répertoire n° 8817"
    },
    {
      "id": "P-005",
      "type": "motif",
      "libelle": "Nom de la propriété (« propriété dite … »)",
      "prefixe": "PROPRIETE",
      "motif": "(?<=\\b(?:propri[ée]t[ée]|immeuble|terrain|parcelle)\\s+(?:dite|d[ée]nomm[ée]e?)\\s*[«\"“]\\s*)[^»\"”\\n]{1,60}?(?=\\s*[»\"”])",
      "exemple": "la propriété dite « Villa Yasmine »"
    },
    {
      "id": "P-006",
      "type": "motif",
      "libelle": "Titre foncier suivant, dans une énumération (« n° 1234/45 et 5678/45 »)",
      "prefixe": "TF",
      "motif": "(?<=(?:\\bfonciers?|\\bT\\.?\\s?F\\.?)\\s*(?:n[°o]s?\\.?)?\\s*[\\d. ]{1,9}\\s?/\\s?[\\dA-Z]{1,3}\\s*(?:,|et)\\s*)(?:\\d{1,3}[. ]\\d{3}|\\d{1,7})\\s?/\\s?(?:\\d{1,3}|[A-Z]{1,2})(?![\\p{L}\\d])",
      "exemple": "titres fonciers n° 1234/45 et 5678/45"
    },
    {
      "id": "P-007",
      "type": "motif",
      "libelle": "Référence d'un acte adoulaire (numéro, page ou folio)",
      "prefixe": "ADOUL",
      "motif": "(?<=\\bacte\\s+(?:adoulaire|d['’]\\s?h[ée]r[ée]dit[ée])\\s*(?:n[°o]s?\\.?|num[ée]ro)\\s*[:=]?\\s*)\\d{1,6}(?:\\s?,?\\s?(?:page|folio|f°)\\s?\\d{1,5})?(?![\\d/])",
      "exemple": "acte adoulaire n° 345, page 210"
    },
