{
  "format": "hidden-tokens.pack/1",
  "id": "juridique-fr",
  "nom": "Juridique — cabinet d'avocats, France",
  "version": "1.1.0",
  "description": "Identifiants des entreprises (SIRET, SIREN annoncé, clé de Luhn) et des procédures (n° RG, n° de parquet annoncé, n° de pourvoi) codés sous leur nom ; juridictions, codes et sources de droit laissés en clair pour que l'IA travaille sur des conclusions ou un jugement.",
  "regles": [
    { "id": "P-001", "type": "motif", "libelle": "SIRET (établissement)", "prefixe": "SIRET",
      "motif": "(?<!\\d)\\d{3}[ .]?\\d{3}[ .]?\\d{3}[ .]?\\d{5}(?!\\d)", "exemple": "123 456 789 01237", "controle": "luhn" },
    { "id": "P-002", "type": "motif", "libelle": "SIREN annoncé (« SIREN », « RCS Ville »)", "prefixe": "SIREN",
      "motif": "(?<=\\b(?:SIREN|RCS[ \\t]+[\\p{L}' -]{2,30}?)[ \\t]*(?:n[°o]\\.?)?[ \\t]*[:=]?[ \\t]*)\\d{3}[ .]?\\d{3}[ .]?\\d{3}(?!\\d)", "exemple": "RCS Paris 123 456 782", "controle": "luhn" },
    { "id": "P-003", "type": "motif", "libelle": "Numéro de répertoire général (RG)", "prefixe": "RG",
      "motif": "\\bRG[ \\t]*(?:n[°o]\\.?)?[ \\t]*\\d{2}/\\d{4,5}(?!\\d)", "exemple": "RG n° 24/01234" },
    { "id": "P-004", "type": "motif", "libelle": "Numéro de parquet annoncé", "prefixe": "PARQUET",
      "motif": "(?<=\\bparquet(?!\\p{L})[ \\t]*(?:n[°o]\\.?)?[ \\t]*[:=]?[ \\t]*)\\d{2}[ \\t]?\\d{3}[ \\t]?\\d{6}(?!\\d)", "exemple": "parquet n° 23 180 000123" },
    { "id": "P-005", "type": "motif", "libelle": "Numéro de pourvoi (Cour de cassation)", "prefixe": "POURVOI",
      "motif": "(?<![\\d.-])\\d{2}-\\d{2}\\.\\d{3}(?![\\d.])", "exemple": "pourvoi n° 21-14.432" },
    { "id": "P-010", "type": "laisser_en_clair", "libelle": "Juridictions et institutions",
      "termes": ["Cour de cassation", "Conseil d'État", "Conseil constitutionnel", "cour d'appel", "tribunal judiciaire", "tribunal de commerce", "conseil de prud'hommes", "tribunal administratif", "CJUE", "CEDH", "URSSAF", "France Travail", "CNIL", "CNB", "Ordre des avocats", "bâtonnier", "greffe"] },
    { "id": "P-011", "type": "laisser_en_clair", "libelle": "Codes et sources de droit",
      "termes": ["Code civil", "Code pénal", "Code du travail", "Code de commerce", "Code de procédure civile", "Code de procédure pénale", "Code de la consommation", "Légifrance", "Dalloz", "LexisNexis", "Lamy"] }
  ]
}
